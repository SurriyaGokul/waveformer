{
    "model": {
        "name": "ComplexToRealUNet",
        "in_channels": 1,
        "base_channels": 32,
        "encoder_depths": [32, 64, 128, 256],
        "upsampling_factor": 20,
        "use_motion_interpolation": true,
        "complex_to_real_mode": "concat",
        "use_naive_bn": true,
        "flow_hidden_channels": 32,
        "flow_scale": 0.1
    },
    "data": {
        "sparse_dir": "data/sparse_iq",
        "velocity_dir": "data/velocity",
        "sparse_pattern": "sparse_*.npy",
        "velocity_prefix": "velocity_",
        "iq_normalization_scalar": 5000.0,
        "apply_clutter_filter": true,
        "train_split": 0.8
    },
    "training": {
        "batch_size": 4,
        "gradient_accumulation_steps": 1,
        "effective_batch_size": 4,
        "num_epochs": 100,
        "warmup_epochs": 5,
        "learning_rate": 1e-4,
        "weight_decay": 1e-5,
        "betas": [0.9, 0.999]
    },
    "loss": {
        "l1_weight": 1.0,
        "gdl_weight": 0.5,
        "boundary_mask_size": 15,
        "use_temporal_gradient": false,
        "temporal_weight": 0.1
    },
    "optimizer": {
        "type": "AdamW",
        "learning_rate": 1e-4,
        "weight_decay": 1e-5,
        "betas": [0.9, 0.999]
    },
    "scheduler": {
        "type": "OneCycleLR",
        "max_lr": 1e-4,
        "pct_start": 0.05,
        "anneal_strategy": "cos"
    },
    "checkpointing": {
        "save_dir": "outputs/velocity_model",
        "save_every_n_epochs": 10,
        "save_best_only": true
    },
    "early_stopping": {
        "patience": 20,
        "min_delta": 1e-5
    },
    "hardware": {
        "use_amp": true,
        "num_workers": 4,
        "pin_memory": true
    },
    "seed": 42
}
