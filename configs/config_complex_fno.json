  "test_ratio": 0.15,
  "use_augmentation": false,
  "num_workers": 4,
  
  "use_amp": false,
  "accumulation_steps": 4,
  
  "save_every": 10,
  "early_stopping_patience": 40,
  
  "physics_params": {
    "dt_seconds": 5e-5,
    "dx_meters": 3.125e-4,
