{
  "experiment_name": "complex_fno_50x_20kHz_trial2",
  "data_dir": "data/CIRS_Phantom_Latest/Data set 1(50)",
  "output_dir": "outputs",
  "device": "cuda",
  "seed": 42,
  
  "in_channels": 1,
  "out_channels": 1,
  "base_channels": 32,
  "num_levels": 4,
  "upsampling_factor": 49,
  
  "fno_hidden_channels": 128,
  "fno_num_modes_height": 16,
  "fno_num_modes_width": 16,
  "fno_num_layers": 4,
  "fno_use_batchnorm": true,
