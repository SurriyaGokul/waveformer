  "epochs": 50,
  "batch_size": 6,
  "learning_rate": 1e-4,
  "weight_decay": 1e-5,
  "gradient_clip": 10.0,
  
  "lr_scheduler": "cosine",
  "lr_step_size": 30,
  "lr_gamma": 0.5,
  "lr_patience": 15,
