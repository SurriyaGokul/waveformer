{
  "experiment_name": "input_guided_velocity_centric",
  "data_dir": "data",
  "output_dir": "outputs",
  
  "in_channels": 1,
  "out_channels": 1,
  "base_channels": 32,
  "num_levels": 4,
  "lstm_hidden_channels": 128,
  "lstm_num_layers": 1,
  "upsampling_factor": 20,
  
  "flow_hidden_channels": 32,
  "flow_scale": 0.1,
  "use_residual_fusion": true,
  "max_flow": 20,
  
  "use_flow_losses": true,
  "use_flow_consistency_loss": true,
  "use_photometric_loss": true,
  "use_flow_smoothness_loss": true,
  "lambda_flow_consistency": 0.001,
  "lambda_photometric": 0.001,
  "lambda_flow_smoothness": 0.0005,
  "flow_loss_warmup_epochs": 5,
  
  "epochs": 150,
  "batch_size": 8,
  "learning_rate": 5e-4,
  "weight_decay": 1e-5,
  "gradient_clip": 50.0,
  
  "lr_scheduler": "cosine",
  "lr_step_size": 30,
  "lr_gamma": 0.5,
  "lr_patience": 10,
  "min_lr": 1e-7,
  
  "_comment_loss_weights": "VELOCITY-CENTRIC: Magnitude-weighted to ignore background noise",
  "use_magnitude_weighted_loss": true,
  "lambda_kasai": 10.0,
  "kasai_threshold_ratio": 0.05,
  "lambda_data": 0.1,
  "lambda_phase": 1.0,
  "lambda_magnitude": 0.0,
  "lambda_smooth": 0.01,
  "lambda_velocity": 100.0,
  "velocity_loss_type": "mse",
  "lambda_wave_equation": 0.0,
  "use_wave_equation_loss": false,
  "phase_threshold_ratio": 0.05,
  
  "sparse_frame_step": 20,
  "fixed_sparse_frames": 3,
  "normalization": "per_sample",
  "train_ratio": 0.7,
  "val_ratio": 0.15,
  "test_ratio": 0.15,
  "use_augmentation": false,
  "num_workers": 4,

  "use_amp": false,
  "accumulation_steps": 1,

  "save_every": 10,
  "early_stopping_patience": 30,
  "use_early_stopping": false,
  "use_train_loss_for_best": true
}